{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "0e40d6e2666c4de8b758007437fd97e3",
    "m_Group": {
        "m_Id": "2c42450bfdff48de91ca23a3f5678479"
    },
    "m_Name": "DistortUV (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1114.0,
            "y": -745.0000610351563,
            "width": 210.0001220703125,
            "height": 118.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "4dfb4c5155d1472986cb99dbc52b2220"
        },
        {
            "m_Id": "578228a8582b44f69ecb6a30872a2b09"
        },
        {
            "m_Id": "838dbd79761b4035ba26eb9549dfc64c"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "DistortUV",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "{\r\n    float time = _Time.y;\r\n\r\n    UV.y += Amount * 0.01 * (sin(UV.x * 3.5 + time * 0.35) + sin(UV.x * 4.8 + time * 1.05) + sin(UV.x * 7.3 + time * 0.45)) / 3.0;\r\n    UV.x += Amount * 0.12 * (sin(UV.y * 4.0 + time * 0.50) + sin(UV.y * 6.8 + time * 0.75) + sin(UV.y * 11.3 + time * 0.2)) / 3.0;\r\n    UV.y += Amount * 0.12 * (sin(UV.x * 4.2 + time * 0.64) + sin(UV.x * 6.3 + time * 1.65) + sin(UV.x * 8.2 + time * 0.45)) / 3.0;\r\n\r\n    Out = UV;\r\n}"
}

